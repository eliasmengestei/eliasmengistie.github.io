<svg width="600" height="400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="blog2Grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#11998e;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#38ef7d;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="600" height="400" fill="url(#blog2Grad)"/>
  <!-- WordPress icon shape -->
  <circle cx="300" cy="155" r="70" fill="white" opacity="0.15"/>
  <circle cx="300" cy="155" r="56" fill="white" opacity="0.9"/>
  <text x="300" y="148" font-family="Arial, sans-serif" font-size="36" fill="#11998e" text-anchor="middle" font-weight="bold">W</text>
  <text x="300" y="178" font-family="Arial, sans-serif" font-size="14" fill="#11998e" text-anchor="middle">WordPress</text>
  <!-- Category badge -->
  <rect x="30" y="30" width="100" height="30" rx="15" fill="white" opacity="0.3"/>
  <text x="80" y="50" font-family="Arial, sans-serif" font-size="14" fill="white" text-anchor="middle" font-weight="bold">WordPress</text>
  <!-- Title -->
  <text x="300" y="285" font-family="Arial, sans-serif" font-size="24" fill="white" text-anchor="middle" font-weight="bold">WordPress Plugin</text>
  <text x="300" y="318" font-family="Arial, sans-serif" font-size="18" fill="white" text-anchor="middle" opacity="0.9">Extensible Guide</text>
  <text x="300" y="358" font-family="Arial, sans-serif" font-size="16" fill="white" text-anchor="middle" opacity="0.85">15 June, 2026</text>
</svg>
