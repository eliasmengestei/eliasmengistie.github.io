<svg width="600" height="400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="blog1Grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#2193b0;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#6dd5ed;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="600" height="400" fill="url(#blog1Grad)"/>
  <!-- Pencil / design icon -->
  <rect x="220" y="100" width="160" height="120" rx="8" fill="white" opacity="0.9"/>
  <rect x="240" y="120" width="100" height="10" rx="5" fill="#2193b0" opacity="0.5"/>
