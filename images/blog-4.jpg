<svg width="600" height="400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="blog4Grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#373b44;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#4286f4;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="600" height="400" fill="url(#blog4Grad)"/>
  <!-- Shopping cart icon -->
  <circle cx="300" cy="150" r="75" fill="white" opacity="0.1"/>
  <circle cx="300" cy="150" r="60" fill="white" opacity="0.9"/>
  <!-- cart shape -->
  <path d="M 272 130 L 276 150 L 296 150 L 330 150 L 326 130 Z" fill="#4286f4" opacity="0.8"/>
  <circle cx="284" cy="162" r="6" fill="#4286f4"/>
  <circle cx="316" cy="162" r="6" fill="#4286f4"/>
