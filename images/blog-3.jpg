<svg width="600" height="400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="blog3Grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ee0979;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#ff6a00;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="600" height="400" fill="url(#blog3Grad)"/>
  <!-- UI mockup shapes -->
  <rect x="110" y="80" width="380" height="200" rx="12" fill="white" opacity="0.15"/>
  <rect x="125" y="95" width="350" height="170" rx="8" fill="white" opacity="0.9"/>
  <!-- mock nav bar -->
  <rect x="125" y="95" width="350" height="28" rx="8" fill="#ee0979" opacity="0.8"/>
  <circle cx="145" cy="109" r="6" fill="white" opacity="0.6"/>
  <circle cx="163" cy="109" r="6" fill="white" opacity="0.6"/>
  <circle cx="181" cy="109" r="6" fill="white" opacity="0.6"/>
  <!-- mock content lines -->
  <rect x="145" y="140" width="200" height="10" rx="5" fill="#ee0979" opacity="0.3"/>
  <rect x="145" y="162" width="280" height="10" rx="5" fill="#ee0979" opacity="0.2"/>
  <rect x="145" y="184" width="220" height="10" rx="5" fill="#ee0979" opacity="0.2"/>
  <rect x="145" y="206" width="180" height="10" rx="5" fill="#ee0979" opacity="0.2"/>
  <!-- Category badge -->
  <rect x="30" y="30" width="80" height="30" rx="15" fill="white" opacity="0.3"/>
  <text x="70" y="50" font-family="Arial, sans-serif" font-size="14" fill="white" text-anchor="middle" font-weight="bold">Design</text>
  <!-- Title -->
  <text x="300" y="320" font-family="Arial, sans-serif" font-size="24" fill="white" text-anchor="middle" font-weight="bold">Top 10 UI Design Trends</text>
  <text x="300" y="360" font-family="Arial, sans-serif" font-size="16" fill="white" text-anchor="middle" opacity="0.85">22 July, 2026</text>
</svg>
